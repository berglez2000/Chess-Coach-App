# Production environment for Chess Coach. Lives at /etc/chess-coach/env (mode 640, root:chess).
# 01-server-setup.sh fills the two __PLACEHOLDERS__; you fill the rest.

# PostgreSQL on the same VM. Password generated by setup script.
DATABASE_URL=postgresql://chess_coach:__DB_PASSWORD__@127.0.0.1:5432/chess_coach

# Public URL users type in the browser. MUST match exactly (scheme, host, no trailing slash),
# otherwise sign-in fails the origin check. Example for Tailscale Funnel:
#   https://chess-coach.tail1234.ts.net
BETTER_AUTH_URL=https://CHANGE-ME.example.com
BETTER_AUTH_SECRET=__AUTH_SECRET__

# AI coaching providers. Leave empty to run engine-only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Engine. Ubuntu apt package installs here.
STOCKFISH_PATH=/usr/games/stockfish
# Optional tuning: lower if the VM feels slow during analysis.
STOCKFISH_DEPTH=
STOCKFISH_MOVETIME_MS=
STOCKFISH_TIMEOUT_MS=
# Optional human-like opponent (needs an x86_64 Maia binary on the VM). Leave empty at first.
MAIA_PATH=
