generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChessColor {
  WHITE
  BLACK
}

enum AnalysisStatus {
  PENDING
  ENGINE_RUNNING
  ENGINE_COMPLETED
  AI_RUNNING
  COMPLETED
  FAILED
}

enum CoachingProvider {
  ANTHROPIC
  OPENAI
}

model AppSettings {
  id String @id @default("local")
  coachingProvider CoachingProvider @default(ANTHROPIC)
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  games         Game[]
  settings      UserSettings?
  puzzleProgress PuzzleProgress[]
  books Book[]
  openings Opening[]
  learningMaterials LearningMaterial[]
  learningProgress LearningProgress[]
  learningProfiles LearningProfileRevision[]
  weeklyPlanWorkspace WeeklyPlanWorkspace?
  weeklyPlanGenerations WeeklyPlanGeneration[]
  weeklyPlanVersions WeeklyPlanVersion[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A user can gain another login method later without changing their identity.
model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model UserSettings {
  userId           String @id
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachingProvider CoachingProvider @default(ANTHROPIC)
}

model Game {
  id             String         @id @default(cuid())
  // Null only for pre-auth imports, hidden until explicitly assigned by the owner CLI.
  ownerId        String?
  owner          User?          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  pgn            String         @db.Text
  initialFen     String
  whiteName      String?
  blackName      String?
  result         String
  playedAt       DateTime?      @db.Date
  event          String?
  site           String?
  round          String?
  openingName    String?
  eco            String?
  timeControl    String?
  termination    String?
  userColor      ChessColor
  analysisStatus AnalysisStatus @default(PENDING)
  analysisError  String?        @db.Text
  analysisToken String?
  analysisLeaseUntil DateTime?
  coachingSummary      String?   @db.Text
  coachingStrengths    String[]
  coachingImprovements String[]
  coachingProvider     CoachingProvider?
  coachingRevision     Int @default(0)
  coachingRunProvider  CoachingProvider?
  coachingRunModel     String?
  coachingModel        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  moves          GameMove[]
  puzzleGenerations PuzzleGeneration[]

  @@index([createdAt, id])
  @@index([ownerId, createdAt, id])
}

// Ownership is inherited from the source game and checked on every access.
model PuzzleGeneration {
  id String @id @default(cuid())
  gameId String
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  version Int
  status String @default("PENDING")
  token String?
  leaseUntil DateTime?
  configuration Json
  checkedCandidates Int @default(0)
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  puzzles PersonalPuzzle[]

  @@unique([gameId, version])
}

model PersonalPuzzle {
  id String @id @default(cuid())
  generationId String
  generation PuzzleGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  sourcePly Int
  sourceRunId String
  startingFen String
  playerColor ChessColor
  acceptedMoves String[]
  validation Json
  solution Json?
  createdAt DateTime @default(now())
  progress PuzzleProgress[]

  @@unique([generationId, sourcePly])
}

// One completion per owner and puzzle version; practice attempts remain separate.
model PuzzleProgress {
  id String @id @default(cuid())
  puzzleId String
  puzzle PersonalPuzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision Int @default(0)
  state String @default("SOLVING")
  assisted Boolean @default(false)
  hintUsed Boolean @default(false)
  solvedMove String?
  playedMoves String[] @default([])
  lastOutcome String?
  moveAttempts Int @default(0)
  completedAt DateTime?
  completionAssisted Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  attempts PuzzleAttempt[]

  @@unique([puzzleId, userId])
  @@index([userId, completedAt])
}

model PuzzleAttempt {
  id String @id @default(cuid())
  progressId String
  progress PuzzleProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  requestId String
  expectedRevision Int
  action String
  move String?
  outcome String
  assisted Boolean
  createdAt DateTime @default(now())

  @@unique([progressId, requestId])
}

model GameMove {
  id         String     @id @default(cuid())
  gameId     String
  game       Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ply        Int
  moveNumber Int
  color      ChessColor
  san        String
  uci        String
  fenBefore  String
  fenAfter   String

  engineAnalysis MoveEngineAnalysis?
  coachingAnnotation MoveCoachingAnnotation?

  @@unique([gameId, ply])
}

// One reusable engine assessment per imported half-move. Raw facts remain versioned JSON.
model MoveEngineAnalysis {
  id             String   @id @default(cuid())
  moveId         String   @unique
  move           GameMove @relation(fields: [moveId], references: [id], onDelete: Cascade)
  runId          String
  beforeCp       Int?
  beforeMate     Int?
  afterCp        Int?
  afterMate      Int?
  bestMoveUci    String?
  bestMoveSan    String?
  pvUci          String[]
  pvSan          String[]
  cpLoss         Int?
  classification String
  assessment     Json
  configuration  Json
  analyzedAt     DateTime @default(now())
}

// One AI coaching annotation per move, produced in a single coaching run.
model MoveCoachingAnnotation {
  id               String   @id @default(cuid())
  moveId           String   @unique
  move             GameMove @relation(fields: [moveId], references: [id], onDelete: Cascade)
  runId            String
  classification   String
  headline         String?  @db.Text
  explanation      String   @db.Text
  lesson           String   @db.Text
  category         String
  model            String
  provider         CoachingProvider @default(ANTHROPIC)
  annotatedAt      DateTime @default(now())
}

// PDFs and reader state are private account data, stored together in PostgreSQL.
model Book {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String
  digest String
  pdf Bytes
  thumbnail Bytes?
  totalPages Int
  currentPage Int @default(1)
  revision Int @default(0)
  lastRead DateTime?
  createdAt DateTime @default(now())
  marks BookMark[]

  @@unique([ownerId, digest])
  @@index([ownerId, createdAt, id])
}

model BookMark {
  id String @id @default(cuid())
  bookId String
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  page Int
  x Float
  y Float

  @@index([bookId, page])
}

model LearningMaterial {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shared Boolean @default(false)
  title String
  edition String @default("")
  revision Int @default(0)
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  chapters LearningChapter[]
  @@index([ownerId, archived])
}
model LearningChapter {
  id String @id @default(cuid())
  materialId String
  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  title String
  order Int @default(0)
  revision Int @default(0)
  archived Boolean @default(false)
  exercises LearningExercise[]
}
model LearningExercise {
  id String @id @default(cuid())
  chapterId String
  chapter LearningChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  number String
  title String
  order Int @default(0)
  archived Boolean @default(false)
  revision Int @default(0)
  draft Json
  status String @default("DRAFT")
  validation Json?
  publishedId String? @unique
  published LearningRevision? @relation("CurrentLearningRevision", fields: [publishedId], references: [id], onDelete: SetNull)
  versions LearningRevision[] @relation("LearningVersions")
  @@unique([chapterId, number])
}
model LearningRevision {
  id String @id @default(cuid())
  exerciseId String
  exercise LearningExercise @relation("LearningVersions", fields: [exerciseId], references: [id], onDelete: Cascade)
  currentFor LearningExercise? @relation("CurrentLearningRevision")
  version Int
  content Json
  validation Json
  createdAt DateTime @default(now())
  progress LearningProgress[]
  @@unique([exerciseId, version])
}
model LearningProgress {
  id String @id @default(cuid())
  revisionId String
  definition LearningRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision Int @default(0)
  state String @default("SOLVING")
  assisted Boolean @default(false)
  hintUsed Boolean @default(false)
  solvedMove String?
  playedMoves String[] @default([])
  lastOutcome String?
  moveAttempts Int @default(0)
  completedAt DateTime?
  completionAssisted Boolean?
  attempts LearningAttempt[]
  @@unique([revisionId, userId])
}
model LearningAttempt {
  id String @id @default(cuid())
  progressId String
  progress LearningProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  requestId String
  expectedRevision Int
  action String
  move String?
  outcome String
  assisted Boolean
  createdAt DateTime @default(now())
  @@unique([progressId, requestId])
}

// Immutable survey inputs; future plans can pin a specific profile revision.
model LearningProfileRevision {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision Int
  answers Json
  resourceTitles Json
  createdAt DateTime @default(now())
  @@unique([userId, revision])
}


model WeeklyPlanWorkspace {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision Int @default(0)
  draftId String? @unique
  draft WeeklyPlanGeneration? @relation("PlanDraft", fields: [draftId], references: [id], onDelete: SetNull)
  generationId String? @unique
  generation WeeklyPlanGeneration? @relation("PlanGeneration", fields: [generationId], references: [id], onDelete: SetNull)
  acceptedId String? @unique
  accepted WeeklyPlanVersion? @relation(fields: [acceptedId], references: [id], onDelete: SetNull)
}
model WeeklyPlanGeneration {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String
  baseRevision Int
  status String @default("RUNNING")
  leaseUntil DateTime
  inputs Json
  provider CoachingProvider
  requestedModel String
  model String?
  definition Json?
  generatedDefinition Json?
  draftRevision Int @default(0)
  error String?
  createdAt DateTime @default(now())
  draftFor WeeklyPlanWorkspace? @relation("PlanDraft")
  generationFor WeeklyPlanWorkspace? @relation("PlanGeneration")
  @@unique([userId, requestId])
  @@index([userId, createdAt])
}
model WeeklyPlanVersion {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  version Int
  generationId String
  draftRevision Int
  definition Json
  inputs Json
  provider CoachingProvider
  model String
  acceptedAt DateTime @default(now())
  currentFor WeeklyPlanWorkspace?
  @@unique([userId, version])
  @@unique([userId, generationId, draftRevision])
}


model Opening {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String
  description String @db.Text
  color ChessColor
  startFen String
  lines Json
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  videos OpeningVideo[]
  @@index([ownerId, updatedAt])
}

model OpeningVideo {
  id String @id
  openingId String
  opening Opening @relation(fields: [openingId], references: [id], onDelete: Cascade)
  name String
  size Int
  createdAt DateTime @default(now())
  @@index([openingId, createdAt])
}
