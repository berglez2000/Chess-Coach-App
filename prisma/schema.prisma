generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChessColor {
  WHITE
  BLACK
}

enum AnalysisStatus {
  PENDING
  ENGINE_RUNNING
  ENGINE_COMPLETED
  AI_RUNNING
  COMPLETED
  FAILED
}

enum CoachingProvider {
  ANTHROPIC
  OPENAI
}

model AppSettings {
  id String @id @default("local")
  coachingProvider CoachingProvider @default(ANTHROPIC)
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  games         Game[]
  settings      UserSettings?
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A user can gain another login method later without changing their identity.
model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model UserSettings {
  userId           String @id
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachingProvider CoachingProvider @default(ANTHROPIC)
}

model Game {
  id             String         @id @default(cuid())
  // Null only for pre-auth imports, hidden until explicitly assigned by the owner CLI.
  ownerId        String?
  owner          User?          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  pgn            String         @db.Text
  initialFen     String
  whiteName      String?
  blackName      String?
  result         String
  playedAt       DateTime?      @db.Date
  event          String?
  site           String?
  round          String?
  openingName    String?
  eco            String?
  timeControl    String?
  termination    String?
  userColor      ChessColor
  analysisStatus AnalysisStatus @default(PENDING)
  analysisError  String?        @db.Text
  analysisToken String?
  analysisLeaseUntil DateTime?
  coachingSummary      String?   @db.Text
  coachingStrengths    String[]
  coachingImprovements String[]
  coachingProvider     CoachingProvider?
  coachingRevision     Int @default(0)
  coachingRunProvider  CoachingProvider?
  coachingRunModel     String?
  coachingModel        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  moves          GameMove[]

  @@index([createdAt, id])
  @@index([ownerId, createdAt, id])
}

model GameMove {
  id         String     @id @default(cuid())
  gameId     String
  game       Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ply        Int
  moveNumber Int
  color      ChessColor
  san        String
  uci        String
  fenBefore  String
  fenAfter   String

  engineAnalysis MoveEngineAnalysis?
  coachingAnnotation MoveCoachingAnnotation?

  @@unique([gameId, ply])
}

// One reusable engine assessment per imported half-move. Raw facts remain versioned JSON.
model MoveEngineAnalysis {
  id             String   @id @default(cuid())
  moveId         String   @unique
  move           GameMove @relation(fields: [moveId], references: [id], onDelete: Cascade)
  runId          String
  beforeCp       Int?
  beforeMate     Int?
  afterCp        Int?
  afterMate      Int?
  bestMoveUci    String?
  bestMoveSan    String?
  pvUci          String[]
  pvSan          String[]
  cpLoss         Int?
  classification String
  assessment     Json
  configuration  Json
  analyzedAt     DateTime @default(now())
}

// One AI coaching annotation per move, produced in a single coaching run.
model MoveCoachingAnnotation {
  id               String   @id @default(cuid())
  moveId           String   @unique
  move             GameMove @relation(fields: [moveId], references: [id], onDelete: Cascade)
  runId            String
  classification   String
  headline         String?  @db.Text
  explanation      String   @db.Text
  lesson           String   @db.Text
  category         String
  model            String
  provider         CoachingProvider @default(ANTHROPIC)
  annotatedAt      DateTime @default(now())
}
