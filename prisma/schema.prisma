generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Coaching annotations are added in later tasks.

enum ChessColor {
  WHITE
  BLACK
}

enum AnalysisStatus {
  PENDING
  ENGINE_RUNNING
  ENGINE_COMPLETED
  AI_RUNNING
  COMPLETED
  FAILED
}

model Game {
  id             String         @id @default(cuid())
  pgn            String         @db.Text
  initialFen     String
  whiteName      String?
  blackName      String?
  result         String
  playedAt       DateTime?      @db.Date
  event          String?
  site           String?
  round          String?
  openingName    String?
  eco            String?
  timeControl    String?
  termination    String?
  userColor      ChessColor
  analysisStatus AnalysisStatus @default(PENDING)
  analysisError  String?        @db.Text
  analysisToken String?
  analysisLeaseUntil DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  moves          GameMove[]

  @@index([createdAt, id])
}

model GameMove {
  id         String     @id @default(cuid())
  gameId     String
  game       Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ply        Int
  moveNumber Int
  color      ChessColor
  san        String
  uci        String
  fenBefore  String
  fenAfter   String

  engineAnalysis MoveEngineAnalysis?

  @@unique([gameId, ply])
}

// One reusable engine assessment per imported half-move. Raw facts remain versioned JSON.
model MoveEngineAnalysis {
  id             String   @id @default(cuid())
  moveId         String   @unique
  move           GameMove @relation(fields: [moveId], references: [id], onDelete: Cascade)
  runId          String
  beforeCp       Int?
  beforeMate     Int?
  afterCp        Int?
  afterMate      Int?
  bestMoveUci    String?
  bestMoveSan    String?
  pvUci          String[]
  pvSan          String[]
  cpLoss         Int?
  classification String
  assessment     Json
  configuration  Json
  analyzedAt     DateTime @default(now())
}
